{
  "name": "@ritojs/core",
  "type": "module",
  "version": "0.13.0",
  "description": "EPUB rendering engine with a Web Canvas backend",
  "license": "AGPL-3.0-only",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "homepage": "https://github.com/Ringyuki/Rito/tree/master/packages/rito#readme",
  "bugs": {
    "url": "https://github.com/Ringyuki/Rito/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ringyuki/Rito.git",
    "directory": "packages/rito"
  },
  "keywords": [
    "epub",
    "canvas",
    "renderer",
    "ebook",
    "typesetting",
    "layout",
    "pagination",
    "reader"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./advanced": {
      "import": "./dist/advanced.mjs",
      "types": "./dist/advanced.d.mts"
    },
    "./web": {
      "import": "./dist/web.mjs",
      "types": "./dist/web.d.mts"
    },
    "./integration": {
      "import": "./dist/integration.mjs",
      "types": "./dist/integration.d.mts"
    },
    "./selection": {
      "import": "./dist/selection.mjs",
      "types": "./dist/selection.d.mts"
    },
    "./search": {
      "import": "./dist/search.mjs",
      "types": "./dist/search.d.mts"
    },
    "./annotations": {
      "import": "./dist/annotations.mjs",
      "types": "./dist/annotations.d.mts"
    },
    "./position": {
      "import": "./dist/position.mjs",
      "types": "./dist/position.d.mts"
    },
    "./a11y": {
      "import": "./dist/a11y.mjs",
      "types": "./dist/a11y.d.mts"
    },
    "./dom": {
      "import": "./dist/dom.mjs",
      "types": "./dist/dom.d.mts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "diagnose:render": "pnpm run build && node scripts/render-diagnostic-case.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:golden:books": "RITO_BOOK_TESTS=1 vitest run tests/golden-books",
    "test:golden:books:smoke": "RITO_BOOK_TESTS=1 vitest run tests/golden-books/golden-books.smoke.test.ts",
    "test:golden:books:update": "RITO_BOOK_TESTS=1 RITO_UPDATE_GOLDEN=1 vitest run tests/golden-books/golden-books.layout.test.ts",
    "test:golden:render": "RITO_RENDER_GOLDEN=1 vitest run tests/golden-render",
    "test:golden:render:update": "RITO_RENDER_GOLDEN=1 RITO_UPDATE_GOLDEN=1 vitest run tests/golden-render",
    "test:golden:pixel": "pnpm run build && RITO_PIXEL_GOLDEN=1 playwright test -c playwright.config.ts",
    "test:golden:pixel:review": "pnpm run build && RITO_PIXEL_GOLDEN=1 RITO_PIXEL_REVIEW=1 playwright test -c playwright.config.ts",
    "test:golden:pixel:update": "pnpm run build && RITO_PIXEL_GOLDEN=1 RITO_UPDATE_GOLDEN=1 playwright test -c playwright.config.ts",
    "test:dom-free:dist": "pnpm run build && node scripts/verify-dom-free-dist.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "css-line-break": "^2.1.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "happy-dom": "^20.10.6",
    "saxes": "^6.0.0",
    "tsdown": "^0.21.7",
    "vitest": "^4.1.2"
  }
}
