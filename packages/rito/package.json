{
  "name": "@ritojs/core",
  "type": "module",
  "version": "2.0.0",
  "description": "Rust-backed EPUB reader core with browser package bindings",
  "license": "AGPL-3.0-only",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "homepage": "https://github.com/Ringyuki/Rito/tree/master/packages/rito#readme",
  "bugs": {
    "url": "https://github.com/Ringyuki/Rito/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ringyuki/Rito.git",
    "directory": "packages/rito"
  },
  "keywords": [
    "epub",
    "canvas",
    "renderer",
    "ebook",
    "typesetting",
    "layout",
    "pagination",
    "reader"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --filter @ritojs/core-wasm build && tsdown && node scripts/copy-wasm-artifact.mjs && node scripts/verify-worker-entry.mjs",
    "dev": "tsdown --watch --on-success \"node scripts/copy-wasm-artifact.mjs\"",
    "diagnose:render": "pnpm --filter @ritojs/core-wasm build && pnpm run build && node scripts/render-diagnostic-case.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:golden:pixel": "pnpm run build && RITO_PIXEL_GOLDEN=1 playwright test -c playwright.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@ritojs/core-wasm": "workspace:*",
    "@types/node": "^25.5.0",
    "fflate": "^0.8.2",
    "tsdown": "^0.21.7",
    "@vitest/coverage-v8": "^4.1.2",
    "vitest": "^4.1.2"
  }
}
