      "response": {
        "protocolVersion": 1,
        "requestId": "fixture-resource",
        "kind": "getResource",
        "ok": true,
        "sessionId": "session-1",
        "revisionId": "rev-1",
        "payload": {
          "resource": {
            "id": "image-1",
            "kind": "image",
            "href": "Images/cover.jpg",
            "mediaType": "image/jpeg"
          },
          "byteLength": 3,
          "transferId": "transfer-1",
          "mediaType": "image/jpeg"
        }
      }
    },
    {
      "name": "close session",
      "command": {
        "protocolVersion": 1,
        "requestId": "fixture-close",
        "kind": "closeSession",
        "sessionId": "session-1"
