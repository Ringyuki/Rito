{
  "schemaVersion": 1,
  "successPath": [
    {
      "name": "open session",
      "command": {
        "protocolVersion": 1,
        "requestId": "fixture-open",
        "kind": "openSession",
        "payload": {
          "publicationRef": "fixture.epub"
        }
      },
      "response": {
        "protocolVersion": 1,
        "requestId": "fixture-open",
        "kind": "openSession",
        "ok": true,
        "sessionId": "session-1",
        "payload": {
          "publication": {
            "metadata": {
              "title": "Fixture",
              "language": "en",
              "identifier": "fixture-id"
            },
            "spineItemCount": 1
          }
        }
      }
    },
    {
      "name": "create revision",
      "command": {
        "protocolVersion": 1,
        "requestId": "fixture-revision",
        "kind": "createRevision",
        "sessionId": "session-1",
        "payload": {
          "viewport": {
            "width": 800,
            "height": 600
          },
          "spreadMode": "double",
          "margin": 24
        }
      },
      "response": {
        "protocolVersion": 1,
        "requestId": "fixture-revision",
        "kind": "createRevision",
        "ok": true,
        "sessionId": "session-1",
        "revisionId": "rev-1",
        "payload": {
          "revision": {
            "id": "rev-1",
            "sessionId": "session-1",
            "layoutKey": "fixture-layout",
            "status": "ready",
            "knownSpreadCount": 3,
            "finalSpreadCount": 3,
            "createdAt": 1000
          }
        }
      }
    },
    {
      "name": "cancel revision",
      "command": {
        "protocolVersion": 1,
        "requestId": "fixture-cancel",
        "kind": "cancelRevision",
        "sessionId": "session-1",
        "revisionId": "rev-1"
      },
      "response": {
        "protocolVersion": 1,
        "requestId": "fixture-cancel",
        "kind": "cancelRevision",
        "ok": true,
        "sessionId": "session-1",
        "revisionId": "rev-1",
        "payload": {
          "cancelled": true
        }
      }
    },
    {
      "name": "resolve locator",
      "command": {
        "protocolVersion": 1,
        "requestId": "fixture-resolve-locator",
        "kind": "resolveLocator",
        "sessionId": "session-1",
