    {
      "name": "prefetch",
      "command": {
        "protocolVersion": 1,
        "requestId": "fixture-prefetch",
        "kind": "prefetch",
        "sessionId": "session-1",
        "revisionId": "rev-1",
        "payload": {
          "spreadIndexes": [1, 2]
