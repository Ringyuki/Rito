                  "mediaType": "application/xhtml+xml",
                  "progression": 0.25,
                  "totalProgression": 0.1,
                  "position": 42,
                  "sourceRange": {
                    "start": 10,
                    "end": 18
                  }
                },
                "sourceTextOffset": 10
