        "revisionId": "rev-1",
        "payload": {
          "locator": {
            "href": "Text/chapter-1.xhtml",
            "mediaType": "application/xhtml+xml",
            "progression": 0.25,
            "sourceRange": {
              "start": 10,
              "end": 18
            }
          },
          "revisionId": "rev-1",
          "pageIndex": 4,
          "spreadIndex": 2
        }
      }
    },
