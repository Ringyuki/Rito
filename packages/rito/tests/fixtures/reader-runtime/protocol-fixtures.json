                  "x": 40,
                  "y": 80,
                  "width": 120,
                  "height": 20
                },
                "locator": {
                  "href": "Text/chapter-1.xhtml",
                  "mediaType": "application/xhtml+xml",
                  "progression": 0.25,
                  "totalProgression": 0.1,
                  "position": 42,
                  "sourceRange": {
                    "start": 10,
                    "end": 18
                  }
                },
                "href": "chapter-2.xhtml",
                "label": "chapter link"
              }
            ],
            "resourceRefs": [
              {
                "id": "image-1",
                "kind": "image",
                "href": "Images/cover.jpg",
                "mediaType": "image/jpeg"
              }
            ],
            "primaryLocator": {
              "href": "Text/chapter-1.xhtml",
              "mediaType": "application/xhtml+xml",
              "progression": 0.25,
              "totalProgression": 0.1,
              "position": 42,
              "sourceRange": {
                "start": 10,
                "end": 18
              }
            }
          }
        }
