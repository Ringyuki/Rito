      "response": {
        "protocolVersion": 1,
        "requestId": "fixture-prefetch",
        "kind": "prefetch",
        "ok": true,
        "sessionId": "session-1",
        "revisionId": "rev-1",
        "payload": {
          "spreadIndexes": [1, 2]
        }
      }
    },
    {
      "name": "search",
      "command": {
        "protocolVersion": 1,
        "requestId": "fixture-search",
        "kind": "search",
        "sessionId": "session-1",
        "revisionId": "rev-1",
        "payload": {
          "query": "highlight",
          "limit": 1
        }
      },
      "response": {
        "protocolVersion": 1,
        "requestId": "fixture-search",
        "kind": "search",
        "ok": true,
        "sessionId": "session-1",
        "revisionId": "rev-1",
        "payload": {
          "results": [
            {
              "locator": {
                "href": "Text/chapter-1.xhtml",
                "mediaType": "application/xhtml+xml",
                "progression": 0.25,
                "sourceRange": {
                  "start": 10,
                  "end": 18
                },
                "text": {
                  "highlight": "highlight"
                }
              },
              "snippet": "fixture highlight text"
            }
          ],
          "hasMore": false
        }
      }
    },
    {
      "name": "get footnote",
      "command": {
        "protocolVersion": 1,
        "requestId": "fixture-footnote",
        "kind": "getFootnote",
        "sessionId": "session-1",
        "revisionId": "rev-1",
        "payload": {
          "ref": {
            "href": "Text/chapter-1.xhtml#fn1"
          }
        }
      },
      "response": {
        "protocolVersion": 1,
        "requestId": "fixture-footnote",
        "kind": "getFootnote",
        "ok": true,
        "sessionId": "session-1",
        "revisionId": "rev-1",
        "payload": {
          "ref": {
            "href": "Text/chapter-1.xhtml#fn1"
          },
          "footnote": {
            "kind": "footnote",
            "text": "Footnote body",
            "html": "<p>Footnote body</p>"
          }
        }
      }
    },
    {
      "name": "get resource",
      "command": {
        "protocolVersion": 1,
        "requestId": "fixture-resource",
        "kind": "getResource",
        "sessionId": "session-1",
        "revisionId": "rev-1",
        "payload": {
          "resource": {
            "id": "image-1",
