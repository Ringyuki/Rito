{
  "name": "@ritojs/reader",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "build:e2e": "pnpm run typecheck && RITO_READER_BASE=/ vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:e2e:downloads-smoke": "playwright test -c playwright.config.ts tests/e2e/reader-downloads-smoke.e2e.test.ts",
    "test:e2e:load-profile": "RITO_READER_HTML_REPORT=1 playwright test -c playwright.config.ts tests/e2e/reader-load-profile.e2e.test.ts",
    "test:e2e:preview-ab": "node tests/e2e/run-reader-preview-ab.mjs",
    "test:e2e:memory-gate": "RITO_READER_STRICT_SERVER=1 RITO_READER_MEMORY_GATE_REQUIRED=1 RITO_READER_HTML_REPORT=1 RITO_READER_MEMORY_GATE=${RITO_READER_MEMORY_GATE:-tests/e2e/memory-gates/ringyuki-macbook-air-m3.json} RITO_READER_MACHINE_ID=${RITO_READER_MACHINE_ID:-ringyuki-macbook-air-m3} playwright test -c playwright.config.ts tests/e2e/memory-gate.e2e.test.ts",
    "test:e2e:usability-gate": "RITO_READER_STRICT_SERVER=1 RITO_READER_USABILITY_GATE_REQUIRED=1 RITO_READER_HTML_REPORT=1 playwright test -c playwright.config.ts tests/e2e/reader-usability-gate.e2e.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.e2e.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@ritojs/core": "workspace:*",
    "@ritojs/kit": "workspace:*",
    "@ritojs/react": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "motion": "^12.38.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.2.2",
    "vite": "^6.4.3"
  }
}
