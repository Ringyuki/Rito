{
  "name": "text-inline-box",
  "width": 460,
  "height": 220,
  "background": "#ffffff",
  "commands": [
    {
      "kind": "paintText",
      "text": "highlighted words",
      "rect": { "x": 20, "y": 14, "width": 160, "height": 20 },
      "paint": {
        "color": "#000000",
        "backgroundColor": "#ffee88",
        "font": { "family": "Tinos", "sizePx": 16, "style": "normal", "weight": 400 }
      }
    },
    {
      "kind": "paintText",
      "text": "rounded highlight",
      "rect": { "x": 20, "y": 50, "width": 150, "height": 20 },
      "paint": {
        "color": "#000000",
        "backgroundColor": "#aaddff",
        "backgroundRadius": 4,
        "font": { "family": "Tinos", "sizePx": 16, "style": "normal", "weight": 400 }
      }
    },
    {
      "kind": "paintText",
      "text": "padded box",
      "rect": { "x": 30, "y": 90, "width": 100, "height": 20 },
      "paint": {
        "color": "#000000",
        "backgroundColor": "#ddffdd",
        "padding": { "top": 2, "right": 6, "bottom": 3, "left": 5 },
        "font": { "family": "Tinos", "sizePx": 16, "style": "normal", "weight": 400 }
      }
    },
    {
      "kind": "paintText",
      "text": "bordered inline code",
      "rect": { "x": 30, "y": 130, "width": 180, "height": 20 },
      "paint": {
        "color": "#333333",
        "backgroundColor": "#f5f5f5",
        "padding": { "top": 1, "right": 4, "bottom": 1, "left": 4 },
        "border": {
          "top": { "widthPx": 1, "paint": { "color": "#888888", "style": "solid" } },
          "bottom": { "widthPx": 1, "paint": { "color": "#888888", "style": "solid" } },
          "start": { "widthPx": 1, "paint": { "color": "#888888", "style": "solid" } },
          "end": { "widthPx": 1, "paint": { "color": "#888888", "style": "solid" } }
        },
        "font": { "family": "Tinos", "sizePx": 15, "style": "normal", "weight": 400 }
      }
    },
    {
      "kind": "paintText",
      "text": "大号中文高亮标题",
      "rect": { "x": 30, "y": 170, "width": 240, "height": 28 },
      "paint": {
        "color": "#000000",
        "backgroundColor": "#ffddee",
        "font": { "family": "Source Han Serif CN", "sizePx": 20, "style": "normal", "weight": 400 }
      }
    }
  ]
}
