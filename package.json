{
  "name": "Rito",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "brace-expansion@5": "5.0.6",
      "js-yaml@3": "3.15.0",
      "js-yaml@4": "4.2.0",
      "postcss": "8.5.10"
    }
  },
  "scripts": {
    "build": "pnpm -r run build",
    "audit:dependencies": "pnpm audit --audit-level=high",
    "changeset": "changeset",
    "release:status": "changeset status --verbose",
    "release:pack-check": "node ./scripts/check-release-tarballs.mjs",
    "version-packages": "changeset version",
    "release:publish": "pnpm publish -r",
    "release:ci": "pnpm run check && pnpm release:pack-check && pnpm release:publish --tag next",
    "dev": "pnpm -r --parallel run dev",
    "dev:reader": "pnpm --filter @ritojs/reader dev",
    "dev:rito": "pnpm --filter ./packages/rito dev",
    "diagnose:render": "pnpm --filter @ritojs/core build && node packages/rito/scripts/render-diagnostic-case.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:unit": "pnpm --filter @ritojs/core test:unit && pnpm --filter @ritojs/kit test && pnpm --filter @ritojs/react test",
    "test:integration": "pnpm --filter @ritojs/core test:integration",
    "test:golden:books": "pnpm --filter @ritojs/core test:golden:books",
    "test:golden:books:smoke": "pnpm --filter @ritojs/core test:golden:books:smoke",
    "test:golden:books:update": "pnpm --filter @ritojs/core test:golden:books:update",
    "test:golden:render": "pnpm --filter @ritojs/core test:golden:render",
    "test:golden:render:update": "pnpm --filter @ritojs/core test:golden:render:update",
    "test:golden:pixel": "pnpm --filter @ritojs/core build && RITO_PIXEL_GOLDEN=1 playwright test -c packages/rito/playwright.config.ts",
    "test:golden:pixel:review": "pnpm --filter @ritojs/core test:golden:pixel:review",
    "test:golden:pixel:update": "pnpm --filter @ritojs/core build && RITO_PIXEL_GOLDEN=1 RITO_UPDATE_GOLDEN=1 playwright test -c packages/rito/playwright.config.ts",
    "test:e2e": "pnpm --filter @ritojs/reader test:e2e",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "test:ci": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test:unit && pnpm run test:integration && pnpm run test:golden:books && pnpm run test:golden:render && pnpm run build",
    "check": "pnpm run test:ci",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": "eslint --fix",
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.0",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "4.1.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
